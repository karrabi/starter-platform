generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id             Int        @id @default(autoincrement())
  title          String
  slug           String     @unique
  content        Json
  status         PageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Media {
  id Int @id @default(autoincrement())

  fileName     String
  originalName String
  mimeType     String
  extension    String

  size Int

  path String

  createdAt DateTime @default(now())
}

model Blog {
  id             Int         @id @default(autoincrement())

  title          String

  slug           String      @unique

  summary        String?     @db.Text

  content        Json

  status         BlogStatus  @default(DRAFT)

  seoTitle       String?

  seoDescription String?     @db.Text

  publishedAt    DateTime?

  createdAt      DateTime    @default(now())

  updatedAt      DateTime    @updatedAt
}

