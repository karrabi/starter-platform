generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum CategoryType {
  BLOG
  PRODUCT
 PORTFOLIO
  SERVICE
}

model Page {
  id             Int        @id @default(autoincrement())
  title          String
  slug           String     @unique
  content        Json
  status         PageStatus @default(DRAFT)
  seo       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Media {
  id Int @id @default(autoincrement())

  fileName     String
  originalName String
  mimeType     String
  extension    String

  size Int

  path String

  createdAt DateTime @default(now())
}

model Blog {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  summary     String?    @db.Text
  content     Json
  status      BlogStatus @default(DRAFT)
  seo         Json?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories BlogCategory[]
  tags       BlogTag[]
}

model Menu {
  id          Int      @id @default(autoincrement())

  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id         Int      @id @default(autoincrement())

  menuId     Int
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  title      String

  url        String

  icon       String?

  parentId   Int?

  parent     MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])

  children   MenuItem[] @relation("MenuTree")

  sortOrder  Int       @default(0)

  target     String?   @default("_self")

  isVisible  Boolean   @default(true)

  createdAt  DateTime  @default(now())

  updatedAt  DateTime  @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())

  name        String

  slug        String

  type        CategoryType

  description String?  @db.Text

  parentId    Int?

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])

  children    Category[] @relation("CategoryTree")

  sortOrder   Int       @default(0)

  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())

  updatedAt   DateTime  @updatedAt

  blogs BlogCategory[]
  products ProductCategory[]
  @@unique([slug, type])
}

model BlogCategory {
  blogId     Int
  categoryId Int

  blog        Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@id([blogId, categoryId])

  @@index([categoryId])
}

enum TagType {
  BLOG
  PRODUCT
  PORTFOLIO
  SERVICE
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String
  type      TagType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs BlogTag[]
  products ProductTag[]
  @@unique([slug, type])
}

model BlogTag {
  blogId Int
  tagId  Int

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([blogId, tagId])
  @@index([tagId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               Int      @id @default(autoincrement())

  name             String

  slug             String   @unique

  shortDescription String?

  description      Json

  seo              Json?

  status           ProductStatus @default(DRAFT)

  featured         Boolean @default(false)

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt

  categories       ProductCategory[]
  tags             ProductTag[]
  gallery Json?
}

model ProductCategory {
  productId  Int
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, tagId])
  @@index([tagId])
}